# WF3: Privacy Reserve Check — Local Simulation Secrets
#
# These values are used by `cre simulate` to provide secrets locally.
# In production, these are stored in the Vault DON (threshold-encrypted).
#
# DO NOT COMMIT THIS FILE — it is gitignored via the root .gitignore.
#
# The variable names here must match the environment variable names
# listed under each secret in secrets.yaml.

# Risk-engine Express server URL
RISK_ENGINE_URL_ENV=http://localhost:3001

# API authentication token (dev-only placeholder)
API_SECRET_ENV=dev-secret-token
